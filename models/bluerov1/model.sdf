<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
  <model name="bluerov1">
    <pose>0 0 0 0 0 0</pose>

    <!--
      BlueROV1 (2015 kit, 6 x T200), derived from the bluerov2 model. See BlueROV1.md for sources/assumptions.
      Thruster positions are measured from Blue Robotics' BROV-R1 CAD, relative to the frame's bounding-box centre.
      Thruster numbering and directions follow ArduSub's BLUEROV1 frame (FRAME_CONFIG = 0):
        1: starboard horizontal, pushes forward      4: front-port vertical, pushes up
        2: port horizontal, pushes forward           5: rear-centre vertical, pushes up
        3: front-starboard vertical, pushes up       6: lateral (below CoM), pushes right
      Positive cmd_thrust pushes along the joint axis (0 0 -1 in the thruster link frame);
      each link is rotated so that axis points in the direction listed above.
    -->

    <link name="base_link">
      <inertial>
        <pose>-0.007 0.0 0.011 0 0 0</pose>
        <mass>6.5</mass>
        <inertia>
          <ixx>0.065</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.129</iyy>
          <iyz>0</iyz>
          <izz>0.185</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.483 0.330 0.267</size>
          </box>
        </geometry>
        <transparency>0.5</transparency>
      </visual>

      <!-- Collision volume * fluid_density == displaced mass, used by the Buoyancy system.
           0.483 x 0.330 x 0.041 = 6.535e-3 m^3 -> 6.535 kg displaced, ~0.5% positively buoyant.
           Centred at the same x as the CoM so the vehicle trims level. -->
      <collision name="base_link_collision">
        <pose>-0.007 0.0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.483 0.330 0.041</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU sensor gyro and accel data will be sent to ArduSub -->
      <sensor name="imu_sensor" type="imu">
        <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
             to the ArduPilot body frame (x-forward, y-right, z-down) -->
        <pose>0 0 0 3.142 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

    </link>

    <!-- Hydrodynamics plugin (quadratic damping scaled from bluerov2 by projected area) -->
    <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>
      <!-- First order stability derivative: -->
      <xU>0</xU>
      <yV>0</yV>
      <zW>0</zW>
      <kP>0</kP>
      <mQ>0</mQ>
      <nR>0</nR>
      <!-- Second order stability derivative: -->
      <xUabsU>-34.7</xUabsU>
      <yVabsV>-60.1</yVabsV>
      <zWabsW>-75.5</zWabsW>
      <kPabsP>-3.992</kPabsP>
      <mQabsQ>-3.992</mQabsQ>
      <nRabsR>-3.992</nRabsR>
    </plugin>

    <!-- 1: starboard horizontal, forward -->
    <link name="thruster1">
      <pose>-0.006 -0.111 0.039 0 -1.571 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov1/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 2: port horizontal, forward -->
    <link name="thruster2">
      <pose>-0.006 0.111 0.039 0 -1.571 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov1/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 3: front-starboard vertical, up.
         CoM x = -0.007 is where ArduSub's throttle factors (0.45, 0.45, 1.0) give zero pitch
         moment with the CAD positions: 2 * 0.45 * (0.178 + 0.007) = 1.0 * (0.174 - 0.007).
         It is also the x station of the horizontal thrusters. -->
    <link name="thruster3">
      <pose>0.178 -0.111 0.016 3.1416 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov1/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 4: front-port vertical, up -->
    <link name="thruster4">
      <pose>0.178 0.111 0.016 3.1416 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov1/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 5: rear-centre vertical, up -->
    <link name="thruster5">
      <pose>-0.174 0.0 -0.072 3.1416 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov1/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 6: lateral, right; mounted below the enclosure, under the CoM (ArduSub mixes in -0.25 roll for this) -->
    <link name="thruster6">
      <pose>0.039 0.0 -0.070 -1.571 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov1/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster1</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster2</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster3</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster4</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster5</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster6</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov1</namespace>
      <joint_name>thruster1_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov1</namespace>
      <joint_name>thruster2_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov1</namespace>
      <joint_name>thruster3_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov1</namespace>
      <joint_name>thruster4_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov1</namespace>
      <joint_name>thruster5_joint</joint_name>
      <!-- Same prop as 2, 4 and 6; the BlueROV manual swaps props only on 1 and 3 -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov1</namespace>
      <joint_name>thruster6_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
           to the ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.142 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Transform from the Gazebo world frame (ENU)
           to the ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 3.142 0 1.571</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>imu_sensor</imuName>

      <!-- Thrusters: T200, same scaling as the bluerov2 model (+-50 N, about T200 forward thrust at 16 V).
           thrust = multiplier * ((pwm - 1100) / 800 + offset) = +-50 N over 1100..1900 us -->
      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov1/joint/thruster1_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov1/joint/thruster2_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov1/joint/thruster3_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov1/joint/thruster4_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov1/joint/thruster5_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov1/joint/thruster6_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>

    </plugin>

  </model>
</sdf>
